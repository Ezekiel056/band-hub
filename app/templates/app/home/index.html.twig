{% extends 'app/_layout/layout.html.twig' %}

{% block content %}
<div class="flex flex-col gap-6 p-4 mb-6 xl:m-auto xl:w-4/5">

  {# KPIs #}
  <div class="grid grid-cols-3 gap-3">

    <div class="card p-4 flex flex-col gap-1">
      <i class="icon icon-music-note icon-size-extra-small"></i>
      <p class="text-2xl font-bold">{{ totalSongs }}</p>
      <p class="text-xs text-(--text-color)">morceaux</p>
    </div>

    <div class="card p-4 flex flex-col gap-1">
      <i class="icon icon-setlist icon-size-extra-small"></i>
      <p class="text-2xl font-bold">{{ totalSetlists }}</p>
      <p class="text-xs text-(--text-color)">setlists</p>
    </div>

    <div class="card p-4 flex flex-col gap-1">
      <i class="icon icon-time icon-size-extra-small"></i>
      <p class="text-2xl font-bold">{{ '%dh%02d'|format((totalDuration // 3600), ((totalDuration % 3600) // 60)) }}</p>
      <p class="text-xs text-(--text-color)">répertoire</p>
    </div>

  </div>

  {# Statuts #}
  <div class="card p-4 flex flex-col gap-4">
    <h2 class="text-lg font-bold">Répertoire par statut</h2>
    <div class="flex flex-col gap-2">
      {% set statuses = [
        {value: 'validated', label: 'Validé',      class: 'song-status-tag-validated'},
        {value: 'learning',  label: 'À apprendre', class: 'song-status-tag-learning'},
        {value: 'pending',   label: 'À voter',      class: 'song-status-tag-pending'},
        {value: 'rejected',  label: 'Rejeté',       class: 'song-status-tag-rejected'},
        {value: 'archived',  label: 'Archivé',      class: 'song-status-tag-archived'},
      ] %}
      {% for status in statuses %}
        {% set count = countByStatus[status.value] ?? 0 %}
        {% set percent = totalSongs > 0 ? (count / totalSongs * 100)|round : 0 %}
        <div class="flex items-center gap-3">
          <a href="{{ path('app_repertoire', {status: status.value}) }}" class="song-tag {{ status.class }} w-32 justify-center text-xs shrink-0">{{ status.label }}</a>
          <div class="flex-auto bg-(--color-border) rounded-full h-2">
            <div class="h-2 rounded-full bg-(--label-color) transition-all" style="width: {{ percent }}%"></div>
          </div>
          <span class="text-sm text-(--text-color) w-6 text-right shrink-0">{{ count }}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Dernières setlists #}
  {% if recentSetlists is not empty %}
  <div class="flex flex-col gap-3">
    <h2 class="text-lg font-bold">Dernières setlists</h2>
    <div class="flex flex-col gap-3">
      {% for setlist in recentSetlists %}
        <a href="{{ path('app_setlist_view', {id: setlist.id}) }}"
           class="card p-4 flex gap-4 items-center">
          <div class="flex justify-center items-center rounded w-12 h-12 shrink-0"
               style="background-color: {{ setlist.color }}">
            <i class="icon icon-setlist icon-size-extra-small"
               style="background-color: color-mix(in srgb, {{ setlist.color }} 30%, black)"></i>
          </div>
          <div class="flex flex-col flex-1 min-w-0">
            <p class="font-bold truncate">{{ setlist.label }}</p>
            <div class="flex gap-3 text-sm text-(--text-color)">
              <span>{{ setlist.setlistModelSongs|length }} morceaux</span>
              <span>{{ '%d:%02d'|format((setlist.getSetlistDuration // 60), (setlist.getSetlistDuration % 60)) }}</span>
            </div>
          </div>
          <i class="icon icon-back-arrow icon-size-extra-small rotate-180 shrink-0"></i>
        </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# Morceaux à apprendre #}
  {% if learningSongs is not empty %}
  <div class="flex flex-col gap-3">
    <h2 class="text-lg font-bold">À apprendre</h2>
    <div class="card flex flex-col divide-y divide-(--color-border) overflow-hidden">
      {% for song in learningSongs %}
        <a href="{{ path('app_song', {id: song.id}) }}"
           class="flex gap-4 items-center p-3 hover:bg-(--card-background-container) transition-colors">
          <img src="{{ asset('/uploads/artists/' ~ song.artist.coverFileName) }}"
               alt="{{ song.artist.name }}"
               class="w-10 h-10 rounded-lg object-cover object-center shrink-0">
          <div class="flex flex-col flex-1 min-w-0">
            <p class="font-bold truncate">{{ song.title }}</p>
            <p class="text-sm text-(--text-color)">{{ song.artist.name }}</p>
          </div>
          <p class="text-sm text-(--text-color) shrink-0">
            {{ '%d:%02d'|format((song.getDuration // 60), (song.getDuration % 60)) }}
          </p>
        </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}
