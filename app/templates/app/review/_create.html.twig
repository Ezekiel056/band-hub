<turbo-frame id="modal">
  <div class="modal active" data-controller="modal">
    <div class="card card-popup max-w-[600px]">
      <h2 class="text-3xl">{{ isEdit ? 'Modifier mon avis' : 'Laisser un avis' }}</h2>
      {{ form_start(form, {action: path('app_review_create')}) }}
        {{ form_row(form.content) }}
        <div class="flex flex-col gap-4 md:flex-row-reverse">
          <button type="submit" class="btn btn-primary flex-1">{{ isEdit ? 'Enregistrer' : 'Envoyer' }}</button>
          <button type="button" class="btn btn-secondary md:w-1/3" data-action="modal#close">Annuler</button>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</turbo-frame>