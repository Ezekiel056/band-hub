{% extends 'app/_layout/layout.html.twig' %}
{% block stylesheets %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
{% endblock %}

{% block headerExtra %}

{% endblock %}


{% block header %}
  <header>
    <div class="header-custom gap-5">
      <a href="{{ app.request.headers.get('referer') ?? path('app_setlists') }}" class="flex items-center "><i class="icon icon-back-arrow icon-size-small bg-(--label-color)"></i></a>
      <h1 class="text-lg font-normal flex-1">{{ setlist.label }}</h1>
{#      <button type="button" data-action="modal#open" data-modal-url-param="{{ path('app_song_edit', {id:song.id}) }}"><i class="icon icon-edit icon-size-small !bg-(--text-color)"></i></button>#}
    </div>
  </header>
{% endblock %}


{% block content %}
  <div class="flex flex-col gap-6 min-h-0 h-full mb-6 p-4 xl:m-auto xl:w-4/5">

   <div class="flex gap-4 items-center">
     <div class="search-input cursor-pointer h-full w-full md:fex-auto">
       <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M9.5 16q-2.725 0-4.612-1.888T3 9.5t1.888-4.612T9.5 3t4.613 1.888T16 9.5q0 1.1-.35 2.075T14.7 13.3l5.6 5.6q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-5.6-5.6q-.75.6-1.725.95T9.5 16m0-2q1.875 0 3.188-1.312T14 9.5t-1.312-3.187T9.5 5T6.313 6.313T5 9.5t1.313 3.188T9.5 14"/></svg>
       <input type="text" data-filter-input placeholder="Rechercher une chanson" class="text-base">
     </div>
     <button class="btn btn-primary hidden w-80 md:block">Ajouter un morceau</button>
   </div>

    <div class="card flex flex-col h-full scrollable-container p-6 pb-2 mb-2">
       <div class="border-b border-(--color-divider) pb-4">
         <div class="flex gap-4 items-center">
           <div class="flex justify-center items-center rounded w-[64px] h-[64px] shrink-0"style="background-color: {{ setlist.color }}">
             <i class="icon icon-setlist icon-size-small" style="background-color: color-mix(in srgb, {{ setlist.color }} 30%, black)"></i>
           </div>

           <div class="flex flex-col flex-auto h-full">
             <h2 class="text-2xl font-bold">{{ setlist.label }}</h2>
             <div class="flex flex-auto gap-2 text-sm">
               <div class="flex gap-1 ">
                <i class="icon icon-time icon-size-extra-small"></i>
                 <p class="text-(--text-color)">{{ '%d:%02d'|format((setlist.getSetlistDuration // 60), (setlist.getSetlistDuration % 60)) }}
               </div>
               <div class="flex gap-1">
                 <i class="icon icon-music-note icon-size-extra-small"></i>
                 <p class="text-(--text-color)">{{ setlist.setlistModelSongs | length }} morceaux</p>
               </div>
             </div>
           </div>

           <a href=""><i class="icon icon-option-menu-side icon-size-small"></i></a>
         </div>
      </div>

      <div class="flex flex-col gap-2 flex-auto scrollable-container py-4"
           data-controller="sortable"
           data-sortable-url-value="{{ path('app_setlist_reorder', {id: setlist.id}) }}">
        {% for setlistModelSong in setlist.setlistModelSongs|sort((a, b) => a.position <=> b.position) %}
          {{ include('/app/setlists/_setlist_song.html.twig') }}
        {% endfor %}
      </div>
    </div>
    <button type="button"  data-action="modal#open"     data-modal-url-param="{{ path('app_song_create') }}" class="btn btn-primary fixed bottom-[80px] right-[10px] flex justify-center items-center md:hidden md:aria-hidden:" aria-label="Ajouter une chanson">
      <i class="icon icon-add !bg-white"></i>
    </button>
  </div>

{% endblock %}


